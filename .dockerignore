# Secrets - supplied at run time, never baked into an image.
.env
.env.*
!.env.example
auth.json

# Version control, editors, agent/CI tooling.
.git
.gitattributes
.github
.editorconfig
.vscode
.freebuff
.mcp.json
boost.json
opencode.json
.DS_Store
*.md
*.log

# Local development environment.
.ddev
xfiles

# Tests are not shipped in the production image.
tests
phpunit.xml
.phpunit.result.cache
database/database.sqlite
*.sqlite

# Dependencies: installed from the manifests inside the build stages.
node_modules
vendor

# Build artefacts: regenerated by `npm run build`, and the local `public/hot`
# marker must never reach a production image or Vite serves assets from a
# dev server that does not exist.
public/build
public/hot
bootstrap/ssr

# Local caches and runtime state from the working copy.
bootstrap/cache/*.php
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/app/private/*
storage/app/public/*
